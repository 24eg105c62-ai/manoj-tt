# ==============================================================================
# Pocket Skill Track - Environment Configuration Template (.env.example)
# Note: Never commit production credentials or secret keys to source control.
# ==============================================================================

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pocketskilltrack
DB_USER=root
DB_PASSWORD=

# Backend Server
SERVER_PORT=8080

# JWT Authentication Secret
# Must be at least 256 bits (32 bytes) hex-encoded for HMAC-SHA256
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# File Upload & PDF Processing Storage
UPLOAD_DIR=./uploads/pdfs
MAX_FILE_SIZE=10MB

# Optional External LLM Integration
# Set LLM_ENABLED=false to utilize the platform's built-in Apache PDFBox Heuristic NLP extraction
LLM_ENABLED=false
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-3.5-turbo

# Frontend URL for CORS Whitelisting
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
